{
  "name": "ConstructionBid",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "simulator": "npm run ios -- --simulator='iPhone SE (3rd generation)'",
    "bigIos": "npm run ios -- --simulator='iPhone 15 Pro Max'",
    "apk": "cd android && ./gradlew assembleRelease && cd ..",
    "abb": "cd android && ./gradlew bundleRelease && cd ..",
    "clean": "cd android && ./gradlew clean && cd ..",
    "info": "cd android && ./gradlew signingReport && cd ..",
    "podinstall": "cd ios && pod install && cd ..",
    "poddeintegrate": "cd ios && pod deintegrate && pod install && cd ..",
    "repoupdate": "cd ios && pod deintegrate && pod install --repo-update && cd ..",
    "cacheclean": "npm start -- --reset-cache",
    "iosDevices": "xcrun simctl list devices"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-picker/picker": "^2.11.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/stack": "^7.1.1",
    "@reduxjs/toolkit": "^2.3.0",
    "@rneui/base": "^4.0.0-rc.8",
    "@rneui/themed": "^4.0.0-rc.8",
    "axios": "^1.6.7",
    "formik": "^2.4.6",
    "moment": "^2.30.1",
    "react": "18.3.1",
    "react-native": "0.77.0",
    "react-native-actionsheet": "^2.4.2",
    "react-native-blob-util": "^0.21.2",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-fast-image": "^8.6.3",
    "react-native-file-viewer": "^2.1.5",
    "react-native-gesture-handler": "^2.22.0",
    "react-native-image-crop-picker": "^0.42.0",
    "react-native-image-picker": "^7.2.3",
    "react-native-image-viewing": "^0.2.2",
    "react-native-keyboard-avoiding-scroll-view": "^1.0.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-loader-kit": "^2.0.8",
    "react-native-modal": "^13.0.1",
    "react-native-permissions": "^5.2.6",
    "react-native-responsive-screen": "^1.4.2",
    "react-native-safe-area-context": "^5.2.0",
    "react-native-screens": "^4.5.0",
    "react-native-toast-message": "^2.2.1",
    "react-native-vector-icons": "^10.2.0",
    "react-redux": "^9.1.2",
    "redux-persist": "^6.0.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.77.0",
    "@react-native/eslint-config": "0.77.0",
    "@react-native/metro-config": "0.77.0",
    "@react-native/typescript-config": "0.77.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
